---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Google, Outlook und Proton in einem Kalender. Andere Werkzeuge planen Termine — Mein Kalender sorgt dafür, dass deine Kalender sich einig sind, wann du frei bist. Gehostet in der EU.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://mein-kalender.link');
const ogImage = new URL('/og.png', Astro.site ?? 'https://mein-kalender.link');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.href} />

    <!-- Schriften liegen lokal. Von fonts.gstatic.com oder cdn.fontshare.com
         geladen, ginge die IP jedes Besuchers in die USA beziehungsweise nach
         Indien — auf einer Seite, die mit EU-Hosting wirbt, waere das schlicht
         unwahr, und in Deutschland abmahnfaehig. -->
    <link rel="preload" href="/fonts/satoshi-700-normal-2.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dmsans-400-normal-1.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mein-kalender.link" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nie wieder doppelt gebucht — Google, Outlook und Proton in einem Kalender." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <script defer src="https://api.pirsch.io/pa.js" id="pianjs" data-code="tlkwjKBDo5OXWaLS7O7kFPuDT8XFnH55"></script>
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <style is:global>
      :root {
        --color-rose-50:  #FFF1F2;
        --color-rose-100: #FFE4E6;
        --color-rose-200: #FECDD3;
        --color-rose-300: #FDA4AF;
        --color-rose-400: #FB7185;
        --color-rose-500: #F43F5E;
        --color-rose-600: #E11D48;
        --color-rose-700: #9F1239;
        --color-rose-800: #881337;

        --color-amber-50:  #FFFBEB;
        --color-amber-200: #FDE68A;
        --color-amber-600: #D97706;
        --color-amber-700: #B45309;
        --color-amber-800: #92400E;

        --color-stone-50:  #FAFAF9;
        --color-stone-100: #F5F5F4;
        --color-stone-200: #E7E5E4;
        --color-stone-300: #D6D3D1;
        --color-stone-400: #A8A29E;
        --color-stone-500: #78716C;
        --color-stone-600: #57534E;
        --color-stone-700: #44403C;
        --color-stone-900: #1C1917;

        --font-display: 'Satoshi', system-ui, sans-serif;
        --font-body: 'DM Sans', system-ui, sans-serif;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }

      body {
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.6;
        color: var(--color-stone-900);
        background: var(--color-stone-50);
        -webkit-font-smoothing: antialiased;
      }

      /* Grain — dieselbe Textur wie in der App (packages/web globals.css).
         DESIGN.md nennt sie "the craft detail that separates from flat
         clinical SaaS"; sie fehlte ausgerechnet auf der Seite, die den
         ersten Eindruck macht. */
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        opacity: 0.03;
        pointer-events: none;
        z-index: 9999;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
        background-repeat: repeat;
        background-size: 256px 256px;
      }

      a { color: var(--color-rose-700); text-decoration: none; }
      a:hover { color: var(--color-rose-800); }
      img, svg { display: block; max-width: 100%; }

      .container { width: 100%; max-width: 1120px; margin: 0 auto; padding: 0 24px; }

      .btn-primary {
        display: inline-flex; align-items: center; justify-content: center;
        background: var(--color-rose-700); color: #fff;
        font-family: var(--font-body); font-weight: 500; font-size: 16px;
        padding: 14px 32px; border-radius: 12px; border: none;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        transition: all 0.15s ease; cursor: pointer;
      }
      .btn-primary:hover { background: var(--color-rose-800); color: #fff; transform: scale(1.02); box-shadow: 0 4px 16px rgba(0,0,0,0.1); }

      @media (prefers-reduced-motion: reduce) {
        * { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
      }
    </style>
  </body>
</html>
